# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Firebase Realtime Database creates the DTOs with reflection (DataSnapshot.getValue),
# so their no-argument constructors, fields and getters/setters must keep their names.
-keep class com.travelmate.data.dto.** { *; }
